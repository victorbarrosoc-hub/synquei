{
  "name": "synquei",
  "version": "1.0.0",
  "description": "Synquei: sincronia de câmeras e áudio pelo som, no navegador, com exportação para Premiere, Resolve, Final Cut, Avid e Vegas.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx http-server -p 8080 -c-1 .",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "smoke": "electron . --smoke",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux dir --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.cjs",
  "author": "Synquei",
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
